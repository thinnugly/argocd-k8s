<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'ArgoCD API Gateway' %></title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
    <link rel="icon" type="image/svg+xml" href="/img/logo-icon.svg">
</head>
<body>
    <div class="background-elements">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>

    <main class="glass-container">
        <header>
            <div class="logo-container">
                <div class="logo-circle"></div>
            </div>
            <h1>ArgoCD API Gateway Renato</h1>
            <div class="subtitle-container">
                <p class="subtitle">
                    <strong>ArgoCD</strong> is a declarative, GitOps-based continuous delivery tool for Kubernetes. 
                    It continuously monitors Git repositories and automatically synchronizes Kubernetes clusters 
                    with the desired application state defined in Git.
                </p>
                <p class="subtitle api-note">
                    <em>* This API (Auth Gateway) was developed as a test application for GitOps laboratories. Below are the available endpoints.</em>
                </p>
            </div>
        </header>

        <section class="endpoints-grid">
            
            <!-- Register Endpoint -->
            <div class="endpoint-card">
                <div class="endpoint-header">
                    <span class="method post">POST</span>
                    <span class="route">/api/auth/register</span>
                    <span class="badge public">Public</span>
                </div>
                <div class="endpoint-body">
                    <h3>Create Account (Register)</h3>
                    <p>Creates a new user in the database with an encrypted password.</p>
                    <div class="code-block">
                        <code>
{
  "name": "João Silva",
  "email": "joao@email.com",
  "password": "senhaSegura123"
}
                        </code>
                    </div>
                </div>
            </div>

            <!-- Login Endpoint -->
            <div class="endpoint-card">
                <div class="endpoint-header">
                    <span class="method post">POST</span>
                    <span class="route">/api/auth/login</span>
                    <span class="badge public">Public</span>
                </div>
                <div class="endpoint-body">
                    <h3>Authentication (Login)</h3>
                    <p>Validates credentials and returns a JWT Token for accessing private routes.</p>
                    <div class="code-block">
                        <code>
{
  "email": "joao@email.com",
  "password": "senhaSegura123"
}
                        </code>
                    </div>
                </div>
            </div>

            <!-- FindAll Endpoint -->
            <div class="endpoint-card private-card">
                <div class="endpoint-header">
                    <span class="method get">GET</span>
                    <span class="route">/api/auth/</span>
                    <span class="badge private">Private</span>
                </div>
                <div class="endpoint-body">
                    <h3>List Users</h3>
                    <p>Returns all registered users from the database. <strong>Requires JWT Token.</strong></p>
                    <div class="auth-requirement">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <span>Header: Authorization: Bearer &lt;token&gt;</span>
                    </div>
                </div>
            </div>

        </section>
    </main>

    <footer>
        <p>
            Developed by <strong>Renato Madeia Muiambo</strong>
        </p>
        <div class="social-links">
            <a href="https://github.com/thinnugly" target="_blank" class="glass-btn">GitHub</a>
            <a href="https://www.linkedin.com/in/renatomuiambo/" target="_blank" class="glass-btn">LinkedIn</a>
        </div>
    </footer>
</body>
</html>